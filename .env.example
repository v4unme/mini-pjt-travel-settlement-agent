# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 선택: 모델 ID (없으면 Claude Sonnet 4.5)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# 점검 기준일 (평가 재현용. 없으면 오늘 날짜)
BASE_DATE=2026-10-21

# API 에 X-Employee-Id 헤더가 없을 때 쓸 데모 직원
DEMO_EMPLOYEE_ID=EMP-001
